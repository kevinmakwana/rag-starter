# --- Database -------------------------------------------------------------
# Host port for the Postgres container (docker compose). If you change it,
# update the port in DATABASE_URL below to match.
DB_PORT=5432
DATABASE_URL=postgres://rag:rag@localhost:5432/rag

# --- Providers ------------------------------------------------------------
# Embeddings: "openai" or "mock" (mock = deterministic, offline, no API key;
# great for trying the app and for CI, but retrieval quality is keyword-level).
EMBEDDING_PROVIDER=mock
# Chat: "openai", "anthropic" or "mock" (mock returns the retrieved context).
CHAT_PROVIDER=mock

OPENAI_API_KEY=
# Optional: any OpenAI-compatible server (Ollama: http://localhost:11434/v1). The key may then be empty.
# Use EMBEDDING_DIM to match the model (nomic-embed-text = 768) and re-create the chunks table.
# OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
# Upper bound on the length of an answer.
ANTHROPIC_MAX_TOKENS=1024

# Must match the embedding model (text-embedding-3-small = 1536).
# Changing it requires a fresh table (the API refuses to start on a mismatch).
EMBEDDING_DIM=1536

# --- Retrieval ------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
# Chunks less similar than this (cosine, 0..1) are dropped before prompting.
# Defaults to 0.2 for OpenAI embeddings and 0.05 for mock embeddings.
# MIN_SCORE=0.2

# "hybrid" fuses vector search with Postgres full-text search (reciprocal rank fusion);
# "vector" uses embeddings only. Compare them with: npm run eval
SEARCH_MODE=hybrid

# Up to this many chunks, vector search is exact (a few tens of ms at most) instead of using the
# approximate HNSW index, which loses recall while deleted chunks linger until VACUUM. 0 = always HNSW.
EXACT_SEARCH_MAX_CHUNKS=20000

# Background ingestion jobs (/jobs/*) that run at the same time.
INGEST_CONCURRENCY=2

# "llm" reorders retrieved passages with the chat model before answering (one extra call per
# question, better ordering on hard questions); "none" skips it.
RERANKER=none

# Previous chat messages used to resolve follow-ups like "and for annual plans?" (0 = no memory).
HISTORY_MESSAGES=6

# --- Servers --------------------------------------------------------------
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
